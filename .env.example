# ---------------------------------------------------------------------------
# Yourbiss environment. Copy to .env.local for development, and paste the same
# names into Vercel (Project -> Settings -> Environment Variables).
# ---------------------------------------------------------------------------

# Supabase  (Project -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_pub_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_pub_...
# Secret key (sb_secret_...). SERVER ONLY. Never expose, never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_...

# Public origin of the app. Used for auth redirects and for absolute embed URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outgoing mail. Supabase's built-in email is intentionally not used.
#   provider=smtp  -> any SMTP relay, including Resend's SMTP server
#                      (smtp.resend.com, port 465 or 587, username "resend",
#                       password = your Resend API key)
#   provider=resend-> Resend REST API
# Workspace-level SMTP credentials are entered in the app under
# Settings -> Email and stored encrypted; these defaults seed a new workspace.
RESEND_API_KEY=
EMAIL_DEFAULT_FROM="Yourbiss <no-reply@yourdomain.com>"

# 32-byte hex key that encrypts workspace SMTP passwords at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Optional: shared secret for the /api/cron endpoints that send reminders and
# prune rate limits. If unset, those endpoints answer 401.
CRON_SECRET=

# GitHub OAuth (Settings -> Sign-in provider). Both Supabase and GitHub need to
# point at <SITE_URL>/auth/callback. Optional: email/password works without it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
